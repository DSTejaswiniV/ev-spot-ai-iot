    "Nearest active EV Charging Station Name" and "Nearest active EV Charging Station Map Co-ordinates"
    *Output from the "routing_agent": Open Google Maps and route to the 
    "Nearest active EV Charging Station Map Co-ordinates" as per the "search_agent" output.
    """,
    greeting_prompt = "Welcome to the Chatbot agent!",
    children = [search_agent, route_agent],
    generate_content_config = types.GenerateContentConfig(temperature=0.2),
    flow = "sequential",
